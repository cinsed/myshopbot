class OrderState(StatesGroup):
    waiting_for_district = State()
    waiting_for_payment = State()

main_kb = InlineKeyboardMarkup(inline_keyboard=[
    [InlineKeyboardButton(text="🛒 Каталог", callback_data="catalog")],
    [InlineKeyboardButton(text="📦 Мои заказы", callback_data="my_orders")],
    [InlineKeyboardButton(text="📞 Поддержка", callback_data="support")]
])

@dp.message(Command("start"))
async def start(message: types.Message):
    cursor.execute("INSERT OR IGNORE INTO users (user_id, username) VALUES (?, ?)", (message.from_user.id, message.from_user.username))
    conn.commit()
    await message.answer("Добро пожаловать!", reply_markup=main_kb)

@dp.callback_query(lambda c: c.data == "catalog")
async def catalog(callback: types.CallbackQuery):
    cursor.execute("SELECT id, name, price_rub, weight FROM products WHERE available = 1")
    prods = cursor.fetchall()
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=f"{p[1]} — {p[2]}₽", callback_data=f"prod_{p[0]}")] for p in prods
    ] + [[InlineKeyboardButton(text="◀ Назад", callback_data="main_menu")]])
    await callback.message.edit_text("Каталог:", reply_markup=kb)
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("prod_"))
async def product(callback: types.CallbackQuery, state: FSMContext):
    pid = int(callback.data.split("_")[1])
    cursor.execute("SELECT name, description, price_rub, weight FROM products WHERE id=?", (pid,))
    p = cursor.fetchone()
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛍 Заказать", callback_data=f"order_{pid}")],
        [InlineKeyboardButton(text="◀ Назад", callback_data="catalog")]
    ])
    await callback.message.edit_text(f"{p[0]}\n{p[1]}\nВес: {p[3]}\nЦена: {p[2]} ₽", reply_markup=kb)
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("order_"))
async def order(callback: types.CallbackQuery, state: FSMContext):
    await state.update_data(product_id=int(callback.data.split("_")[1]))
    await callback.message.edit_text("📍 Укажи город и район:")
    await state.set_state(OrderState.waiting_for_district)
    await callback.answer()

@dp.message(OrderState.waiting_for_district)
async def district(message: types.Message, state: FSMContext):
    data = await state.get_data()
    cursor.execute("SELECT price_rub FROM products WHERE id=?", (data["product_id"],))
    price = cursor.fetchone()[0]
    crypto = round(price / 6500, 6)
    await state.update_data(crypto_amount=crypto, price=price)
    await message.answer(
        f"Сумма: {price} ₽\nК оплате: {crypto} USDT\n\nКошелёк: TMBQtrL9iX79vWF7jqZjNnQjPGL8aLh7\n\nОплати и нажми кнопку.",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="✅ Оплатил", callback_data="paid")],
            [InlineKeyboardButton(text="❌ Отмена", callback_data="main_menu")]
        ])
    )
    await state.set_state(OrderState.waiting_for_payment)

@dp.callback_query(lambda c: c.data == "paid", OrderState.waiting_for_payment)
async def paid(callback: types.CallbackQuery, state: FSMContext):
    await callback.message.edit_text("Проверяю...")
    await asyncio.sleep(2)
    data = await state.get_data()
    cursor.execute("INSERT INTO orders (user_id, product_id, status, crypto_amount) VALUES (?,?,?,?)",
                   (callback.from_user.id, data["product_id"], "paid", data["crypto_amount"]))
    conn.commit()
    await callback.message.edit_text("✅ Заказ оплачен!\n\n📍 Адрес: ул. Примерная, д.5\n📦 Место: под лестницей, чёрный свёрток\n\n⚠️ Удали переписку.")
    await state.clear()
    await callback.answer()

@dp.callback_query(lambda c: c.data == "main_menu")
async def menu(callback: types.CallbackQuery, state: FSMContext = None):
    if state: await state.clear()
    await callback.message.edit_text("Меню:", reply_markup=main_kb)
    await callback.answer()

@dp.callback_query(lambda c: c.data == "my_orders")
async def orders(callback: types.CallbackQuery):
    cursor.execute("SELECT id, product_id, status, created_at FROM orders WHERE user_id=? ORDER BY created_at DESC LIMIT 5", (callback.from_user.id,))
    ords = cursor.fetchall()
    if not ords:
        await callback.message.edit_text("Нет заказов.", reply_markup=main_kb)
        return
    text = "Заказы:\n\n"
    for o in ords:
        cursor.execute("SELECT name FROM products WHERE id=?", (o[1],))
        pn = cursor.fetchone()
        text += f"#{o[0]} | {pn[0] if pn else '?'} | {o[2]} | {o[3]}\n"
    await callback.message.edit_text(text, reply_markup=main_kb)
    await callback.answer()

@dp.callback_query(lambda c: c.data == "support")
async def support(callback: types.CallbackQuery):
    await callback.message.edit_text("📞 @admin", reply_markup=main_kb)
    await callback.answer()

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
