categories = {
    "cat_stim": ("🔼 Стимуляторы", ["Альфа-PVP", "Мефедрон", "Амфетамин", "Метамфетамин", "Кокаин"]),
    "cat_psych": ("🌈 Психоделики", ["LSD 250мкг", "2C-B", "Грибы псилоцибы"]),
    "cat_weed": ("🌿 Каннабис", ["Шишки AK-47", "Гашиш"]),
    "cat_pharm": ("💊 Аптека", ["Лирика 300мг", "Ксанакс 2мг"]),
}

@dp.callback_query(lambda c: c.data.startswith("cat_"))
async def show_category(callback: CallbackQuery):
    cat_key = callback.data
    if cat_key not in categories:
        await callback.answer("Категория не найдена.")
        return
    cat_name, product_names = categories[cat_key]
    cursor.execute(
        "SELECT id, name, price_rub, weight FROM products WHERE available = 1 AND name IN ({})".format(
            ",".join(["?"] * len(product_names))
        ), product_names
    )
    products = cursor.fetchall()
    if not products:
        await callback.message.edit_text("Товаров пока нет.", reply_markup=build_main_kb())
        await callback.answer()
        return
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=f"{p[1]} — {p[2]}₽ ({p[3]})", callback_data=f"product_{p[0]}")]
        for p in products
    ] + [[InlineKeyboardButton(text="◀ Назад", callback_data="main_menu")]])
    await callback.message.edit_text(f"{cat_name}\nВыбери товар:", reply_markup=kb)
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("product_"))
async def product_detail(callback: CallbackQuery, state: FSMContext):
    product_id = int(callback.data.split("_")[1])
    cursor.execute("SELECT name, description, price_rub, weight FROM products WHERE id = ?", (product_id,))
    p = cursor.fetchone()
    if not p:
        await callback.answer("Товар не найден.")
        return
    text = f"*{p[0]}* — {p[3]}\n_{p[1]}_\n\n💰 Цена: *{p[2]} ₽*"
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🛍 Заказать", callback_data=f"order_{product_id}")],
        [InlineKeyboardButton(text="◀ Назад", callback_data="main_menu")]
    ])
    await callback.message.edit_text(text, reply_markup=kb, parse_mode="Markdown")
    await callback.answer()

@dp.callback_query(lambda c: c.data.startswith("order_"))
async def order_start(callback: CallbackQuery, state: FSMContext):
    product_id = int(callback.data.split("_")[1])
    await state.update_data(product_id=product_id)
    await callback.message.edit_text("📍 Укажи город и район для доставки:")
    await state.set_state(OrderState.waiting_for_district)
    await callback.answer()

@dp.message(OrderState.waiting_for_district)
async def district_received(message: Message, state: FSMContext):
    district = message.text
    data = await state.get_data()
    product_id = data["product_id"]
    cursor.execute("SELECT price_rub FROM products WHERE id = ?", (product_id,))
    price = cursor.fetchone()[0]
    crypto_amount = round(price / 6500, 6)
    await state.update_data(district=district, crypto_amount=crypto_amount, price=price)
    text = (
        f"🧾 *Заказ оформлен*\n\n"
        f"💰 Сумма: *{price} ₽*\n"
        f"📍 Район: *{district}*\n"
        f"💎 К оплате: *{crypto_amount} USDT* (TRC20)\n\n"
        f"Отправь ровно эту сумму на кошелёк:\n"
        f"`TMBQtrL9iX79vWF7jqZjNnQjPGL8aLh7`\n\n"
        f"После оплаты нажми кнопку ниже."
    )
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="✅ Я оплатил", callback_data="check_payment")],
        [InlineKeyboardButton(text="❌ Отмена", callback_data="main_menu")]
    ])
    await message.answer(text, reply_markup=kb, parse_mode="Markdown")
    await state.set_state(OrderState.waiting_for_payment)

@dp.callback_query(lambda c: c.data == "check_payment", OrderState.waiting_for_payment)
async def check_payment(callback: CallbackQuery, state: FSMContext):
    await callback.message.edit_text("🔄 Проверяю платёж...")
    await asyncio.sleep(2)
    data = await state.get_data()
    cursor.execute(
        "INSERT INTO orders (user_id, product_id, status, crypto_amount) VALUES (?, ?, ?, ?)",
        (callback.from_user.id, data["product_id"], "paid", data["crypto_amount"])
    )
    conn.commit()
    await callback.message.edit_text(
        "✅ *Заказ оплачен!*\n\n"
        "📍 *Адрес:* ул. Примерная, д.5, 3-й подъезд\n"
        "📦 *Место:* под лестницей, за трубой, чёрный свёрток\n"
        "🔑 *Код:* 4455\n\n"
        "⚠️ Удали переписку после получения.",
        parse_mode="Markdown"
    )
    await state.clear()
    await callback.answer()

@dp.callback_query(lambda c: c.data == "my_orders")
async def my_orders(callback: CallbackQuery):
    cursor.execute(
        "SELECT id, product_id, status, created_at FROM orders WHERE user_id = ? ORDER BY created_at DESC LIMIT 5",
        (callback.from_user.id,)
    )
    orders = cursor.fetchall()
    if not orders:
        await callback.message.edit_text("У тебя пока нет заказов.", reply_markup=build_main_kb())
        await callback.answer()
        return
    text = "*📦 Твои заказы:*\n\n"
    for o in orders:
        cursor.execute("SELECT name FROM products WHERE id = ?", (o[1],))
        pname = cursor.fetchone()
        pname = pname[0] if pname else "Товар удалён"
        text += f"#{o[0]} | {pname} | {o[2]} | {o[3]}\n"
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="◀ Назад", callback_data="main_menu")]
    ])
    await callback.message.edit_text(text, reply_markup=kb, parse_mode="Markdown")
    await callback.answer()

